@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">Book Management</h2>
            <p class="text-muted mb-0">Manage your library collection and book details.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3">
            <i class="bi bi-plus-lg me-2"></i>Add Book
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success-subtle text-success p-3">
                        <i class="bi bi-book fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">Total Books</p>
                        <h3 class="fw-bold mb-0">@Model.Count</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <h5 class="fw-bold mb-0">Library Collection</h5>
                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="bookSearch"
                           class="form-control bg-light border-start-0"
                           placeholder="Search books...">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover" id="booksTable">
                    <thead>
                        <tr class="text-muted small">
                            <th class="py-3">ID</th>
                            <th class="py-3">BOOK TITLE</th>
                            <th class="py-3">CATEGORY</th>
                            <th class="py-3 text-end">PRICE</th>
                            <th class="py-3 text-end">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td class="text-muted">#@book.BookId</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="book-icon">
                                            <i class="bi bi-book-half"></i>
                                        </div>
                                        <span class="fw-semibold">@book.Title</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                        @(book.Category ?? "Uncategorized")
                                    </span>
                                </td>
                                <td class="text-end fw-semibold">
                                    @(book.Price?.ToString("N2") ?? "—")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@book.BookId"
                                       class="btn btn-sm btn-light border rounded-2 me-1">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@book.BookId"
                                       class="btn btn-sm btn-outline-danger rounded-2">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div id="noBooksFound" class="text-center text-muted py-4" style="display:none;">
                    No books match your search.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .book-icon {
        width: 42px;
        height: 48px;
        border-radius: 10px;
        background: #e5f6eb;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .table thead th {
        border-bottom: 1px solid #e9ecef;
        white-space: nowrap;
    }

    .table tbody td {
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .table tbody tr:last-child td {
        border-bottom: 0;
    }
</style>

<script>
    document.getElementById("bookSearch").addEventListener("input", function () {
        const query = this.value.toLowerCase();
        const rows = document.querySelectorAll("#booksTable tbody tr");
        let visible = 0;

        rows.forEach(row => {
            const match = row.textContent.toLowerCase().includes(query);
            row.style.display = match ? "" : "none";
            if (match) visible++;
        });

        document.getElementById("noBooksFound").style.display =
            visible === 0 ? "block" : "none";
    });
</script>