cshtml
@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">Loan Management</h2>
            <p class="text-muted mb-0">Manage book borrowings, due dates, and returns.</p>
        </div>

        <a asp-action="Borrow" class="btn btn-primary px-4 py-2 rounded-3">
            <i class="bi bi-journal-plus me-2"></i>Borrow a Book
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3">
                        <i class="bi bi-journal-bookmark fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">Total Loans</p>
                        <h3 class="fw-bold mb-0">@Model.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning-subtle text-warning p-3">
                        <i class="bi bi-book-half fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">Books Out</p>
                        <h3 class="fw-bold mb-0">@Model.Count(l => l.Status == "Out")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-danger-subtle text-danger p-3">
                        <i class="bi bi-exclamation-circle fs-3"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">Overdue Loans</p>
                        <h3 class="fw-bold mb-0">@Model.Count(l => l.Status == "Overdue")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <h5 class="fw-bold mb-0">Loan Directory</h5>

                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="loanSearch"
                           class="form-control bg-light border-start-0"
                           placeholder="Search loans...">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover" id="loansTable">
                    <thead>
                        <tr class="text-muted small">
                            <th class="py-3">MEMBER</th>
                            <th class="py-3">BOOK</th>
                            <th class="py-3">LOANED DATE</th>
                            <th class="py-3">DUE DATE</th>
                            <th class="py-3">STATUS</th>
                            <th class="py-3 text-end">ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var loan in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle">
                                            @(string.IsNullOrWhiteSpace(loan.MemberName)
                                                ? "?"
                                                : loan.MemberName.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="fw-semibold">@loan.MemberName</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-medium">@loan.BookTitle</span>
                                </td>

                                <td class="text-muted">
                                    @loan.LoanedOn.ToString("yyyy-MM-dd")
                                </td>

                                <td class="text-muted">
                                    @loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    <span class="badge rounded-pill px-3 py-2
                                        @(loan.Status == "Overdue"
                                            ? "bg-danger-subtle text-danger"
                                            : loan.Status == "Out"
                                                ? "bg-warning-subtle text-warning"
                                                : "bg-secondary-subtle text-secondary")">
                                        @loan.Status
                                    </span>
                                </td>

                                <td class="text-end">
                                    @if (loan.ReturnedOn == null)
                                    {
                                        <form asp-action="Return"
                                              asp-route-id="@loan.LoanId"
                                              method="post"
                                              class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success rounded-2">
                                                <i class="bi bi-check-circle me-1"></i>Return
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="bi bi-check-circle-fill text-success me-1"></i>
                                            Completed
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div id="noLoansFound" class="text-center text-muted py-4" style="display:none;">
                    No loans match your search.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: #e8efff;
        color: #3159b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .table thead th {
        border-bottom: 1px solid #e9ecef;
        white-space: nowrap;
    }

    .table tbody td {
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .table tbody tr:last-child td {
        border-bottom: 0;
    }
</style>

<script>
    document.getElementById("loanSearch").addEventListener("input", function () {
        const query = this.value.toLowerCase();
        const rows = document.querySelectorAll("#loansTable tbody tr");
        let visible = 0;

        rows.forEach(row => {
            const match = row.textContent.toLowerCase().includes(query);
            row.style.display = match ? "" : "none";
            if (match) visible++;
        });

        document.getElementById("noLoansFound").style.display =
            visible === 0 ? "block" : "none";
    });
</script>