
@model library.Models.Note

@{
    ViewData["Title"] = "Delete Note";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-danger-subtle text-danger text-center p-4">
                    <div class="delete-icon mx-auto mb-3">
                        <i class="bi bi-journal-x"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Delete Note?</h3>
                    <p class="mb-0">
                        Please review the details before continuing.
                    </p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <p class="text-muted text-center mb-4">
                        Are you sure you want to permanently delete this note?
                    </p>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="mb-3">
                            <small class="text-muted d-block">Note ID</small>
                            <span class="fw-semibold">#@Model.NoteId</span>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block">Title</small>
                            <span class="fw-semibold">@Model.Title</span>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block">Body</small>
                            <p class="mb-0 text-break">
                                @(string.IsNullOrWhiteSpace(Model.Body)
                                    ? "No body provided"
                                    : Model.Body)
                            </p>
                        </div>

                        <div>
                            <small class="text-muted d-block">Date</small>
                            <span>
                                @(Model.Date?.ToString("MMMM dd, yyyy") ?? "—")
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-warning small">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        This action permanently removes the note and cannot
                        be undone.
                    </div>

                    <form asp-action="Delete"
                          asp-route-id="@Model.NoteId"
                          method="post">
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <button type="submit"
                                    class="btn btn-danger btn-lg flex-grow-1">
                                <i class="bi bi-trash me-2"></i>Confirm Delete
                            </button>
                            <a asp-action="Index"
                               class="btn btn-light border btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .delete-icon {
        width: 72px;
        height: 72px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(220, 53, 69, .12);
        font-size: 32px;
    }
</style>
