@model List<Member>
@{
    ViewData["Title"] = "Member";
}
 
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Members</h1>
        <p class="text-muted mb-0">@Model.Count books in the catalogue</p>
    </div>
    @* Task 9 puts the Add a book button here *@
</div>
 
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Full Name</th>
            <th>Email</th>
            <th class="text-end">Member Type</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td class="text-end">@member.MemberId</td>
                <td>@member.FullName</td>
                <td><span class="badge text-bg-secondary">@(member.Email ?? "—")</span></td>
                <td class="text-end">@(member.MemberType ?? "—")</td>
                <td class="text-end">
                    @* Task 10 puts the Edit button here *@
                    @* Task 11 puts the Delete button here *@
                </td>
            </tr>
        }
    </tbody>
</table>
